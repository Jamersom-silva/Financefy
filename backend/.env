# ============================================================
# 🌍 VARIÁVEIS DE AMBIENTE — FINANCEFY BACKEND
# ============================================================
# Este arquivo define as configurações básicas de ambiente.
# Em produção, todas as chaves sensíveis devem ser trocadas
# por valores seguros (ex: via painel do Render, Railway ou AWS).

# ============================================================
# 🔐 DJANGO CONFIG
# ============================================================

# Chave secreta do Django — gere uma nova com:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-dev-key-change-me

# Define se o modo de depuração está ativo:
# True  → ambiente de desenvolvimento
# False → ambiente de produção (recomendado para deploy)
DEBUG=True

# Lista de domínios permitidos para o backend
# (em produção, use seu domínio ou IP do servidor)
ALLOWED_HOSTS=127.0.0.1,localhost

# ============================================================
# 💾 BANCO DE DADOS
# ============================================================
# Em ambiente de desenvolvimento, o Financefy usa SQLite,
# um banco leve e local (não requer instalação).
#
# Para deploy em produção, basta substituir por um PostgreSQL:
# Exemplo:
# DATABASE_URL=postgresql://user:senha@host:5432/nome_banco
#
# O Django automaticamente reconhece e faz a conexão.
DATABASE_URL=sqlite:///db.sqlite3

# ============================================================
# 🔐 AUTENTICAÇÃO JWT (SimpleJWT)
# ============================================================
# O tempo de vida dos tokens é definido no settings.py
# Não há necessidade de configuração adicional aqui,
# mas pode ser usado para ajustar políticas de segurança no futuro.

# ============================================================
# 🌐 CORS (FRONTEND)
# ============================================================
# URLs permitidas para o frontend acessar o backend.
# Em dev, usamos o React local (localhost).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ============================================================
# 🧰 OUTRAS CONFIGURAÇÕES
# ============================================================
# Variáveis extras podem ser adicionadas aqui futuramente,
# como API Keys externas, serviços de e-mail ou integrações.
