# ===========================================
#  Git Attributes — Financefy (Django + React)
# ===========================================

# -----------------------------
# 🔹 Normalização de line endings
# -----------------------------
* text=auto eol=lf

# Mantém arquivos Python sempre LF
*.py text eol=lf

# Mantém arquivos frontend sempre LF
*.js  text eol=lf
*.jsx text eol=lf
*.ts  text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.md text eol=lf

# -----------------------------
# 🔹 Arquivos que não devem ser convertidos (binários)
# -----------------------------
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.rar binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.mp4 binary
*.mov binary
*.webm binary

# -----------------------------
# 🔹 Django migrations — mostrar como texto normal
# -----------------------------
*/migrations/*.py   text
*/migrations/*.pyc  binary

# -----------------------------
# 🔹 Melhorias para o GitHub Linguist
# -----------------------------
# Ignorar arquivos compilados
*.css map linguist-generated=true
*.js.map linguist-generated=true

# Marcar TypeScript como linguagem primária
*.ts linguist-detectable=true
*.tsx linguist-detectable=true

# Marcar arquivos de build como ignorados
dist/* linguist-vendored=true
build/* linguist-vendored=true

# -----------------------------
# 🔹 Segurança
# -----------------------------
# Nunca marcar .env como texto legível por diffs
.env linguist-generated=true
*.env linguist-generated=true

# -----------------------------
# 🔹 Melhor experiência em code review
# -----------------------------
# Evita que PDFs e binários abram no diff
*.pdf   -diff
*.zip   -diff
*.rar   -diff
*.mp4   -diff
*.png   -diff
*.jpg   -diff
*.jpeg  -diff
